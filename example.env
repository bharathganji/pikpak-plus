# Do not change this
FLASK_APP=app.py
FLASK_DEBUG=1

# pikpak email, password (Required)
user=example@example.com
passwd=example

# Supabase Project URL, anon public-key (Required)
SUPABASE_URL=https://example.supabase.co
SUPABASE_KEY=example string key

# optional 
proxy=

# GH_TOKEN (optional)
GH_TOKEN=

# UI Application Port (optional)
# Port to expose the UI application on the host machine.
# Options:
#   - Specific port: e.g. APP_PORT=3001 or APP_PORT=8080
#   - Dynamic port: Set APP_PORT=0 to let Docker automatically allocate an available ephemeral host port
#   - Default: 3000
APP_PORT=3000

# Optional: Bind Host IP (e.g. HOST_IP=127.0.0.1 to only allow local access, or leave blank for 0.0.0.0)
# HOST_IP=127.0.0.1

# Optional: Ports for backend and Redis (if uncommented in docker-compose.yml)
# SERVER_PORT=5000
# REDIS_PORT=6379

# File Size Limit (in GB) - Maximum file size allowed for downloads (optional)
# Uses whatslink.info API to check file sizes before creating tasks
# Default: 25 GB
MAX_FILE_SIZE_GB=25

# Task Scheduler Configuration (optional)
# Task status update interval in minutes - how often to check and update task statuses
# Default: 15 minutes
TASK_STATUS_UPDATE_INTERVAL_MINUTES=15

# Cleanup interval in hours - how often to run cleanup job
# Supports any value (24, 48, 72, etc.)
# Default: 24 hours (once per day)
CLEANUP_INTERVAL_HOURS=24

# Cache Configuration (optional)
# Cache TTL in seconds - how long to cache API responses
# Default: 300 seconds (5 minutes)
TASK_CACHE_TTL_SECONDS=300

# Quota cache TTL in seconds - how long to cache quota information
# Default: 10800 seconds (3 hours)
QUOTA_CACHE_TTL_SECONDS=10800

# VIP Info Cache TTL in seconds - how long to cache VIP information
# Default: 604800 seconds (7 days)
VIP_INFO_CACHE_TTL_SECONDS=604800

# Pagination Configuration (optional)
# Default page size for task lists
# Default: 25 items per page
DEFAULT_PAGE_SIZE=25

# WebDAV Auto-Generation Configuration (optional)
# How often to generate new WebDAV clients in hours
# Default: 24 hours (once per day)
WEBDAV_GENERATION_INTERVAL_HOURS=24

# Redis Configuration (optional)
# Redis URL for caching - defaults to local Redis server
REDIS_URL=redis://localhost:6379/0

# Authentication Configuration
# IMPORTANT: Change these values in production!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeThisSecurePassword123!

# JWT Configuration (optional)
# Secret key for signing JWT tokens - auto-generated if not provided
# IMPORTANT: Set this to a secure random string in production!
# JWT_SECRET_KEY=your-secret-key-here
JWT_EXPIRATION_HOURS=24

# Password Reset Configuration (optional)
# How long password reset tokens are valid in hours
# Default: 1 hour
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1


# Email / Brevo SMTP Configuration (optional)
# Configure these to enable automated password reset emails via Brevo (Sendinblue) or any SMTP provider.
# Brevo offers 300 free emails/day. Obtain SMTP credentials from: Brevo Dashboard -> Settings -> SMTP & API
# If left blank, password reset links fall back to safe server console logging (development mode).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-account-email@example.com
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_FROM_NAME=PikPak Plus
# FRONTEND_URL=http://localhost:3000
