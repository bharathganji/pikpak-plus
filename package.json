{
  "name": "pikpak-plus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "release": "semantic-release",
    "lint:commits": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "sync-versions": "node scripts/sync-version.js",
    "lint": "npm run lint:client && npm run lint:server",
    "lint:fix": "npm run lint:client:fix && npm run lint:server:fix",
    "lint:client": "npm --prefix pikpak-plus-client run lint",
    "lint:client:fix": "npm --prefix pikpak-plus-client run lint:fix && prettier --write \"pikpak-plus-client/src/**/*.{js,jsx,ts,tsx}\"",
    "lint:server": "uvx ruff check pikpak-plus-server",
    "lint:server:fix": "uvx ruff check --fix pikpak-plus-server && uvx ruff format pikpak-plus-server",
    "format": "prettier --check . && uvx ruff format --check pikpak-plus-server",
    "format:fix": "prettier --write . && uvx ruff format pikpak-plus-server",
    "fix": "npm run lint:fix && npm run format:fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^8.57.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.2"
  },
  "release": {
    "extends": "./release.config.js"
  },
  "lint-staged": {
    "pikpak-plus-client/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --config pikpak-plus-client/eslint.config.mjs --fix"
    ],
    "*.{js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "pikpak-plus-server/**/*.py": [
      "uvx ruff check --fix",
      "uvx ruff format"
    ],
    "*.py": [
      "uvx ruff check --fix",
      "uvx ruff format"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "undici": "^6.24.0"
  }
}
